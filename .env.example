# Required: the language model. Default provider is the enterprise Accenture GenAI Wrapper. Fill in real values in .env only (never commit it).
LLM_PROVIDER=genai
GENAI_TOKEN_URL=
GENAI_AUTH_CLIENT_ID=
GENAI_AUTH_CLIENT_SECRET=
GENAI_SCOPE=
GENAI_BASE_URL=
GENAI_CLIENT_ID=
GENAI_DEAL_ID=
GENAI_ENGINE_ID=
GENAI_MODEL_ID=
GENAI_MODEL_NAME=
GENAI_USER_ID=spec2code
# GENAI_TOOL / GENAI_TOOL_CHOICE: wrapper routing fields (default spec2code); confirm the allowed values for the deal

# Alternative provider (LLM_PROVIDER=anthropic): an ENTERPRISE-account Anthropic key only, never a personal one.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=      (company gateway, optional)
# ANTHROPIC_MODEL=
# NOTE: a few agents (spec gap chat, code cross-reference, SAS cross-validation, spec suggestion, rule proposer, synthetic data/validation) still read ANTHROPIC_API_KEY directly until they move to llm_client.py.

# Optional -- all shown values are the actual defaults if omitted
DATABASE_URL=sqlite:///./cdm_spec_to_cql.db
PRECEDENTS_PATH=precedents.jsonl
RAG_TOP_K=3
RAG_MIN_SCORE=0.15
XGBOOST_MODEL_PATH=tier3_model.json
